<Application x:Class="ArmAware.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <!-- Status palette: one hue per optimization status, tuned separately for light and dark themes. -->
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="StatusNativeForegroundBrush" Color="#6CCB5F"/><SolidColorBrush x:Key="StatusNativeBackgroundBrush" Color="#296CCB5F"/>
     <SolidColorBrush x:Key="StatusUpgradeForegroundBrush" Color="#60CDFF"/><SolidColorBrush x:Key="StatusUpgradeBackgroundBrush" Color="#2960CDFF"/>
     <SolidColorBrush x:Key="StatusEmulatedForegroundBrush" Color="#FFC83D"/><SolidColorBrush x:Key="StatusEmulatedBackgroundBrush" Color="#29FFC83D"/>
     <SolidColorBrush x:Key="StatusMixedForegroundBrush" Color="#C9A8FF"/><SolidColorBrush x:Key="StatusMixedBackgroundBrush" Color="#29C9A8FF"/>
     <SolidColorBrush x:Key="StatusUnknownForegroundBrush" Color="#ABABAB"/><SolidColorBrush x:Key="StatusUnknownBackgroundBrush" Color="#1FABABAB"/>
     <SolidColorBrush x:Key="StatusAllForegroundBrush" Color="#E4E4E4"/><SolidColorBrush x:Key="StatusAllBackgroundBrush" Color="#1FFFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="StatusNativeForegroundBrush" Color="#0F7B0F"/><SolidColorBrush x:Key="StatusNativeBackgroundBrush" Color="#1F0F7B0F"/>
     <SolidColorBrush x:Key="StatusUpgradeForegroundBrush" Color="#005FB8"/><SolidColorBrush x:Key="StatusUpgradeBackgroundBrush" Color="#1A005FB8"/>
     <SolidColorBrush x:Key="StatusEmulatedForegroundBrush" Color="#9D5D00"/><SolidColorBrush x:Key="StatusEmulatedBackgroundBrush" Color="#2EF7A600"/>
     <SolidColorBrush x:Key="StatusMixedForegroundBrush" Color="#6B3FB5"/><SolidColorBrush x:Key="StatusMixedBackgroundBrush" Color="#1A6B3FB5"/>
     <SolidColorBrush x:Key="StatusUnknownForegroundBrush" Color="#5D5D5D"/><SolidColorBrush x:Key="StatusUnknownBackgroundBrush" Color="#145D5D5D"/>
     <SolidColorBrush x:Key="StatusAllForegroundBrush" Color="#1A1A1A"/><SolidColorBrush x:Key="StatusAllBackgroundBrush" Color="#0F000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="StatusNativeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="StatusNativeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="StatusUpgradeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="StatusUpgradeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="StatusEmulatedForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="StatusEmulatedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="StatusMixedForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="StatusMixedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="StatusUnknownForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="StatusUnknownBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="StatusAllForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="StatusAllBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <x:String x:Key="GlyphAll">&#xE71D;</x:String>
   <x:String x:Key="GlyphNative">&#xE930;</x:String>
   <x:String x:Key="GlyphUpgrade">&#xE896;</x:String>
   <x:String x:Key="GlyphEmulated">&#xE7BA;</x:String>
   <x:String x:Key="GlyphMixed">&#xE8AB;</x:String>
   <x:String x:Key="GlyphUnknown">&#xE9CE;</x:String>
   <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
   <Style x:Key="CardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
   </Style>
   <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Margin" Value="0,8,0,4"/>
   </Style>
   <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Style>
   <Style x:Key="FieldValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="IsTextSelectionEnabled" Value="True"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
   </Style>
   <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   </Style>
   <!-- Stat cards are buttons so a click filters the list to that status. -->
   <Style x:Key="StatCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
