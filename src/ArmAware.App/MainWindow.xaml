<Window x:Class="ArmAware.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ArmAware.App.ViewModels" Title="ArmAware">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <!-- Custom title bar: content extends into the caption area so Mica runs edge to edge. -->
  <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Source="ms-appx:///Assets/AppLogo.png" Width="20" Height="20" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
   <TextBlock Grid.Column="1" Text="ArmAware" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
   <Border Grid.Column="2" Padding="6,1" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
    <TextBlock Text="Preview" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Border>
  </Grid>

  <Grid Grid.Row="1" Padding="24,4,24,16" RowSpacing="16" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- Page header -->
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Installed applications" Style="{StaticResource TitleTextBlockStyle}"/>
     <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
      <Run Text="{x:Bind ViewModel.HostSummary}"/><Run Text="  •  "/><Run Text="{x:Bind ViewModel.LastScan, Mode=OneWay}"/>
     </TextBlock>
    </StackPanel>
    <Button Grid.Column="1" Click="Export_Click" IsEnabled="{x:Bind ViewModel.HasReport, Mode=OneWay}" ToolTipService.ToolTip="Export the completed scan as JSON or CSV" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDE1;" FontSize="14"/><TextBlock Text="Export"/></StackPanel>
    </Button>
    <Button Grid.Column="2" Click="Settings_Click" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings and privacy" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="14"/><TextBlock Text="Settings"/></StackPanel>
    </Button>
    <Button x:Name="ScanButton" Grid.Column="3" Command="{x:Bind ViewModel.ScanCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Padding="14,6">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="14"/><TextBlock Text="Scan applications"/></StackPanel>
    </Button>
   </Grid>

   <!-- Status overview: the cards are the filter; the active one is outlined -->
   <Grid Grid.Row="1" ColumnSpacing="10">
    <Grid.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24"/></TransitionCollection></Grid.ChildrenTransitions>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Style="{StaticResource StatCardButtonStyle}" Command="{x:Bind ViewModel.ShowFilterCommand}" CommandParameter="0"
            BorderBrush="{x:Bind CardBorder(ViewModel.FilterIndex, 0), Mode=OneWay}" BorderThickness="{x:Bind CardThickness(ViewModel.FilterIndex, 0), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind CardName(ViewModel.Total, 'applications in total', ViewModel.FilterIndex, 0), Mode=OneWay}" ToolTipService.ToolTip="All applications">
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Width="32" Height="32" CornerRadius="7" Background="{ThemeResource StatusAllBackgroundBrush}" VerticalAlignment="Center"><FontIcon Glyph="{StaticResource GlyphAll}" FontSize="15" Foreground="{ThemeResource StatusAllForegroundBrush}"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.Total, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="All apps" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Button>
    <Button Grid.Column="1" Style="{StaticResource StatCardButtonStyle}" Command="{x:Bind ViewModel.ShowFilterCommand}" CommandParameter="1"
            BorderBrush="{x:Bind CardBorder(ViewModel.FilterIndex, 1), Mode=OneWay}" BorderThickness="{x:Bind CardThickness(ViewModel.FilterIndex, 1), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind CardName(ViewModel.Upgrades, 'with an ARM64 build available', ViewModel.FilterIndex, 1), Mode=OneWay}" ToolTipService.ToolTip="ARM64 available">
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Image Source="ms-appx:///Assets/Art/status-arm64-available.png" Width="38" Height="38" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.Upgrades, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource StatusUpgradeForegroundBrush}"/><TextBlock Text="ARM64 available" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Button>
    <Button Grid.Column="2" Style="{StaticResource StatCardButtonStyle}" Command="{x:Bind ViewModel.ShowFilterCommand}" CommandParameter="2"
            BorderBrush="{x:Bind CardBorder(ViewModel.FilterIndex, 2), Mode=OneWay}" BorderThickness="{x:Bind CardThickness(ViewModel.FilterIndex, 2), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind CardName(ViewModel.Emulated, 'running under emulation', ViewModel.FilterIndex, 2), Mode=OneWay}" ToolTipService.ToolTip="Emulated">
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Image Source="ms-appx:///Assets/Art/status-emulated.png" Width="38" Height="38" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.Emulated, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource StatusEmulatedForegroundBrush}"/><TextBlock Text="Emulated" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Button>
    <Button Grid.Column="3" Style="{StaticResource StatCardButtonStyle}" Command="{x:Bind ViewModel.ShowFilterCommand}" CommandParameter="4"
            BorderBrush="{x:Bind CardBorder(ViewModel.FilterIndex, 4), Mode=OneWay}" BorderThickness="{x:Bind CardThickness(ViewModel.FilterIndex, 4), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind CardName(ViewModel.Mixed, 'with mixed or hybrid architecture', ViewModel.FilterIndex, 4), Mode=OneWay}" ToolTipService.ToolTip="Mixed / hybrid">
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Image Source="ms-appx:///Assets/Art/status-mixed.png" Width="38" Height="38" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.Mixed, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource StatusMixedForegroundBrush}"/><TextBlock Text="Mixed / hybrid" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Button>
    <Button Grid.Column="4" Style="{StaticResource StatCardButtonStyle}" Command="{x:Bind ViewModel.ShowFilterCommand}" CommandParameter="3"
            BorderBrush="{x:Bind CardBorder(ViewModel.FilterIndex, 3), Mode=OneWay}" BorderThickness="{x:Bind CardThickness(ViewModel.FilterIndex, 3), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind CardName(ViewModel.Native, 'native ARM64', ViewModel.FilterIndex, 3), Mode=OneWay}" ToolTipService.ToolTip="Native ARM64">
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Image Source="ms-appx:///Assets/Art/status-native.png" Width="38" Height="38" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.Native, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource StatusNativeForegroundBrush}"/><TextBlock Text="Native ARM64" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Button>
    <Button Grid.Column="5" Style="{StaticResource StatCardButtonStyle}" Command="{x:Bind ViewModel.ShowFilterCommand}" CommandParameter="5"
            BorderBrush="{x:Bind CardBorder(ViewModel.FilterIndex, 5), Mode=OneWay}" BorderThickness="{x:Bind CardThickness(ViewModel.FilterIndex, 5), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind CardName(ViewModel.Unknown, 'with unknown status', ViewModel.FilterIndex, 5), Mode=OneWay}" ToolTipService.ToolTip="Unknown">
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Image Source="ms-appx:///Assets/Art/status-unknown.png" Width="38" Height="38" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.Unknown, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="Unknown" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Button>
   </Grid>

   <!-- Scan progress, warnings and action feedback -->
   <StackPanel Grid.Row="2" Spacing="8">
    <Grid Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="{x:Bind ViewModel.Stage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
      <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}"/>
     </StackPanel>
     <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" VerticalAlignment="Center"/>
    </Grid>
    <InfoBar Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}">
     <InfoBar.ActionButton><Button Content="Details" Click="NoticeDetails_Click" Visibility="{x:Bind ViewModel.HasNoticeDetails, Mode=OneWay}"/></InfoBar.ActionButton>
    </InfoBar>
    <InfoBar Title="What the colours mean" Message="Unknown means ArmAware could not confirm which file is the app's main program, so it does not guess." Severity="Informational" IsOpen="{x:Bind ViewModel.ColourKeyOpen, Mode=TwoWay}">
     <InfoBar.IconSource><FontIconSource Glyph="&#xE790;"/></InfoBar.IconSource>
     <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource StatusNativeBackgroundBrush}">
       <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{StaticResource GlyphNative}" FontSize="12" Foreground="{ThemeResource StatusNativeForegroundBrush}"/><TextBlock Text="Native ARM64: no emulation" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StatusNativeForegroundBrush}"/></StackPanel>
      </Border>
      <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource StatusUpgradeBackgroundBrush}">
       <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{StaticResource GlyphUpgrade}" FontSize="12" Foreground="{ThemeResource StatusUpgradeForegroundBrush}"/><TextBlock Text="ARM64 available: you can switch" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StatusUpgradeForegroundBrush}"/></StackPanel>
      </Border>
      <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource StatusEmulatedBackgroundBrush}">
       <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{StaticResource GlyphEmulated}" FontSize="12" Foreground="{ThemeResource StatusEmulatedForegroundBrush}"/><TextBlock Text="Emulated: x86/x64" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StatusEmulatedForegroundBrush}"/></StackPanel>
      </Border>
      <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource StatusMixedBackgroundBrush}">
       <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{StaticResource GlyphMixed}" FontSize="12" Foreground="{ThemeResource StatusMixedForegroundBrush}"/><TextBlock Text="Mixed / hybrid" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StatusMixedForegroundBrush}"/></StackPanel>
      </Border>
      <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource StatusUnknownBackgroundBrush}">
       <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{StaticResource GlyphUnknown}" FontSize="12" Foreground="{ThemeResource StatusUnknownForegroundBrush}"/><TextBlock Text="Unknown" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StatusUnknownForegroundBrush}"/></StackPanel>
      </Border>
     </StackPanel>
    </InfoBar>
    <InfoBar x:Name="Feedback" IsOpen="False"/>
   </StackPanel>

   <!-- Results and evidence -->
   <Grid Grid.Row="3" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="520"/><ColumnDefinition Width="2*" MinWidth="340"/></Grid.ColumnDefinitions>

    <Border Style="{StaticResource CardBorderStyle}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Padding="12" ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search applications or publishers" QueryIcon="Find" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search applications"/>
       <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" MinWidth="150" AutomationProperties.Name="Sort applications"><ComboBoxItem Content="Sort by name"/><ComboBoxItem Content="Sort by status"/><ComboBoxItem Content="Sort by publisher"/></ComboBox>
       <CheckBox Grid.Column="2" Content="Hide system tools" IsChecked="{x:Bind ViewModel.HideSystemTools, Mode=TwoWay}" MinWidth="0" ToolTipService.ToolTip="Hide OS-signed packages and entries marked as system components. Exports still contain the full scan."/>
      </Grid>
      <Grid Grid.Row="1" Padding="28,8,28,8" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
       <TextBlock Text="Application" Style="{StaticResource ColumnHeaderStyle}"/>
       <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource ColumnHeaderStyle}"/>
       <TextBlock Grid.Column="2" Text="Architecture" Style="{StaticResource ColumnHeaderStyle}"/>
       <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource ColumnHeaderStyle}"/>
      </Grid>
      <ListView x:Name="ResultsList" Grid.Row="2" Padding="0,4" ItemsSource="{x:Bind ViewModel.Rows}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Installed applications">
       <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset"/></ItemsPanelTemplate></ListView.ItemsPanel>
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
       <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:FindingRow">
         <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
          <Grid ColumnSpacing="12">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <Grid Width="32" Height="32" VerticalAlignment="Center">
            <Border CornerRadius="6" Background="{x:Bind StatusBackground}" Visibility="{x:Bind NoIcon, Mode=OneWay}">
             <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" Foreground="{x:Bind StatusForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" Visibility="{x:Bind HasIcon, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
           </Grid>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
            <TextBlock Text="{x:Bind Publisher}" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <TextBlock Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
           <TextBlock Text="{x:Bind UpdateLabel}" Visibility="{x:Bind UpdateAvailable}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{x:Bind ArchitectureDisplay}" Foreground="{x:Bind ArchitectureForeground}" ToolTipService.ToolTip="{x:Bind ArchitectureTooltip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"/>
          <Border Grid.Column="3" Padding="8,3" CornerRadius="10" Background="{x:Bind StatusBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="12" Foreground="{x:Bind StatusForeground}"/>
            <TextBlock Text="{x:Bind Status}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind StatusForeground}"/>
           </StackPanel>
          </Border>
         </Grid>
        </DataTemplate>
       </ListView.ItemTemplate>
      </ListView>
      <StackPanel Grid.Row="2" Visibility="{x:Bind ViewModel.ShowStandardEmptyState, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360" Padding="16">
       <Image Source="{x:Bind ViewModel.EmptyArt, Mode=OneWay}" Width="150" Height="150" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
       <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
       <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
       <Button Content="Scan applications" Command="{x:Bind ViewModel.ScanCommand}" Visibility="{x:Bind ViewModel.ShowEmptyScanButton, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
       <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" HorizontalAlignment="Center"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- Evidence pane -->
    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
     <Grid>
      <StackPanel Visibility="{x:Bind ViewModel.NoSelection, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="280">
       <Image Source="ms-appx:///Assets/Art/empty-select-app.png" Width="140" Height="140" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
       <TextBlock Text="Application evidence" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
       <TextBlock Text="Select an application to see why it got its status and what ArmAware found." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
      <ScrollViewer x:Name="DetailScroll" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Padding="20,18,20,18">
       <StackPanel Spacing="4">
        <Grid ColumnSpacing="14">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Grid Width="48" Height="48">
          <Border CornerRadius="10" Background="{x:Bind ViewModel.Selected.StatusBackground, Mode=OneWay}" Visibility="{x:Bind ViewModel.Selected.NoIcon, Mode=OneWay}">
           <TextBlock Text="{x:Bind ViewModel.Selected.Initial, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.Selected.StatusForeground, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image Source="{x:Bind ViewModel.Selected.Icon, Mode=OneWay}" Width="44" Height="44" Visibility="{x:Bind ViewModel.Selected.HasIcon, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
         </Grid>
         <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          <TextBlock Text="{x:Bind ViewModel.Selected.PublisherAndVersion, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
         </StackPanel>
        </Grid>

        <Border Margin="0,14,0,4" Padding="14,12" CornerRadius="8" Background="{x:Bind ViewModel.Selected.StatusBackground, Mode=OneWay}">
         <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Image Source="{x:Bind ViewModel.Selected.StatusArt, Mode=OneWay}" Width="32" Height="32" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw"/>
          <StackPanel Grid.Column="1" Spacing="2">
           <TextBlock Text="{x:Bind ViewModel.Selected.Status, Mode=OneWay}" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.Selected.StatusForeground, Mode=OneWay}"/>
           <TextBlock Text="{x:Bind ViewModel.Selected.Recommendation, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          </StackPanel>
         </Grid>
        </Border>

        <StackPanel Visibility="{x:Bind ViewModel.HasWingetCommand, Mode=OneWay}" Spacing="6" Margin="0,8,0,0">
         <TextBlock Text="Switch to the ARM64 build" Style="{StaticResource SectionHeaderStyle}"/>
         <TextBlock Text="{x:Bind ViewModel.SwitchIntro, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" Margin="0"/>
         <TextBlock Text="1. Remove the x64 version" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0"/>
         <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="8">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{x:Bind ViewModel.UninstallCommand, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
           <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top"><Button Tag="uninstall" Click="RunOne_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6" AutomationProperties.Name="Run the remove command" ToolTipService.ToolTip="Run the remove command in Terminal"><FontIcon Glyph="&#xE768;" FontSize="13"/></Button><Button Tag="{x:Bind ViewModel.UninstallCommand, Mode=OneWay}" Click="CopyText_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6" VerticalAlignment="Top" AutomationProperties.Name="Copy the remove command" ToolTipService.ToolTip="Copy the remove command"><FontIcon Glyph="&#xE8C8;" FontSize="13"/></Button></StackPanel>
          </Grid>
         </Border>
         <TextBlock Text="2. Install the ARM64 version" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0"/>
         <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="8">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{x:Bind ViewModel.WingetCommand, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
           <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top"><Button Tag="install" Click="RunOne_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6" AutomationProperties.Name="Run the install command" ToolTipService.ToolTip="Run the install command in Terminal"><FontIcon Glyph="&#xE768;" FontSize="13"/></Button><Button Tag="{x:Bind ViewModel.WingetCommand, Mode=OneWay}" Click="CopyText_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6" VerticalAlignment="Top" AutomationProperties.Name="Copy the install command" ToolTipService.ToolTip="Copy the install command"><FontIcon Glyph="&#xE8C8;" FontSize="13"/></Button></StackPanel>
          </Grid>
         </Border>
         <TextBlock Text="Run them in this order, a few seconds apart. Installing first usually does nothing, because winget sees the app is already installed. Run in Terminal and Copy both commands add the pause for you. Rescan afterwards to confirm it shows as Native ARM64." Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HasActions, Mode=OneWay}">
         <Button Click="RunSwitch_Click" AutomationProperties.Name="Run in Terminal" Visibility="{x:Bind ViewModel.HasWingetCommand, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Opens a terminal and runs both commands after you confirm">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock Text="Run in Terminal"/></StackPanel>
         </Button>
         <Button Click="Copy_Click" Visibility="{x:Bind ViewModel.HasWingetCommand, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14"/><TextBlock Text="Copy both commands"/></StackPanel>
         </Button>
         <Button Click="Package_Click" Visibility="{x:Bind ViewModel.HasPackageUrl, Mode=OneWay}" ToolTipService.ToolTip="Opens the official winget-pkgs manifest on GitHub">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="14"/><TextBlock Text="View manifest"/></StackPanel>
         </Button>
         <Button Click="SearchArm64_Click" Visibility="{x:Bind ViewModel.ShowSearchAction, Mode=OneWay}" ToolTipService.ToolTip="Opens a web search for this app's ARM64 download in your browser. Sends the app's name to the search engine.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="14"/><TextBlock Text="Search for an ARM64 build"/></StackPanel>
         </Button>
        </StackPanel>

        <StackPanel Visibility="{x:Bind ViewModel.HasUpdateCommand, Mode=OneWay}" Spacing="6" Margin="0,8,0,0">
         <TextBlock Text="Update available" Style="{StaticResource SectionHeaderStyle}"/>
         <TextBlock Text="{x:Bind ViewModel.Selected.UpdateSummary, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" Margin="0"/>
         <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="8">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{x:Bind ViewModel.UpdateCommand, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
           <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top"><Button Tag="update" Click="RunOne_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6" AutomationProperties.Name="Run the update command" ToolTipService.ToolTip="Run the update command in Terminal"><FontIcon Glyph="&#xE768;" FontSize="13"/></Button><Button Tag="{x:Bind ViewModel.UpdateCommand, Mode=OneWay}" Click="CopyText_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6" VerticalAlignment="Top" AutomationProperties.Name="Copy the update command" ToolTipService.ToolTip="Copy the update command"><FontIcon Glyph="&#xE8C8;" FontSize="13"/></Button></StackPanel>
          </Grid>
         </Border>
         <Button Click="RunUpdate_Click" AutomationProperties.Name="Run update in Terminal" ToolTipService.ToolTip="Opens a terminal and runs the update after you confirm">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock Text="Run update in Terminal"/></StackPanel>
         </Button>
        </StackPanel>

        <TextBlock Text="Executable evidence" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,4"/>
        <TextBlock Text="No primary executable could be identified." Visibility="{x:Bind ViewModel.Selected.NoExecutables, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Executables, Mode=OneWay}">
         <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ExecutableRow">
           <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <StackPanel Spacing="4">
             <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}"/>
              <Border Grid.Column="1" Padding="6,1" CornerRadius="4" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
               <TextBlock Text="{x:Bind Architecture}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"/>
              </Border>
             </Grid>
             <TextBlock Text="{x:Bind Path}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
             <TextBlock Text="{x:Bind Confidence}" Style="{StaticResource FieldLabelStyle}"/>
             <TextBlock Text="{x:Bind Evidence}" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
             <TextBlock Text="{x:Bind Limitation}" Visibility="{x:Bind HasLimitation}" FontSize="12" FontStyle="Italic" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="ARM64 availability" Style="{StaticResource SectionHeaderStyle}"/>
        <TextBlock Text="{x:Bind ViewModel.Selected.AvailabilityEvidence, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
        <StackPanel Visibility="{x:Bind ViewModel.Selected.HasWarnings, Mode=OneWay}">
         <TextBlock Text="Warnings" Style="{StaticResource SectionHeaderStyle}"/>
         <TextBlock Text="{x:Bind ViewModel.Selected.Warnings, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
        </StackPanel>

        <Expander Header="Installation details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
         <StackPanel>
          <Grid ColumnSpacing="16">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Scope" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.Scope, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
            <TextBlock Text="Winget ID" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.WingetId, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
            <TextBlock Text="Package match confidence" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.MatchConfidence, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
           </StackPanel>
           <StackPanel Grid.Column="1">
            <TextBlock Text="Package architecture" Style="{StaticResource FieldLabelStyle}" ToolTipService.ToolTip="How the package is labelled. This does not decide how the app runs."/><TextBlock Text="{x:Bind ViewModel.Selected.PackageArchitecture, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
            <TextBlock Text="ARM64 package" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.Availability, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
            <TextBlock Text="Confidence in status" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.Confidence, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
           </StackPanel>
          </Grid>
          <TextBlock Text="Location" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.Location, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"/>
          <TextBlock Text="Package" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.Package, Mode=OneWay}" Style="{StaticResource FieldValueStyle}"/>
          <TextBlock Text="Inventory sources" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.Selected.Sources, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"/>
         </StackPanel>
        </Expander>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Border>
   </Grid>

   <!-- Footer -->
   <Grid Grid.Row="4" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="1" Text="Runs locally. Reads executable metadata only: no live process monitoring, and nothing is changed unless you choose Run in Terminal." Style="{StaticResource FieldLabelStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
   </Grid>
  </Grid>
  <!-- Welcome: full window before the main app on first run; reopen from Settings. -->
  <ScrollViewer Grid.Row="1" Visibility="{x:Bind ViewModel.ShowWelcome, Mode=OneWay}">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="680" Padding="24,8,24,24">
    <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24"/></TransitionCollection></StackPanel.ChildrenTransitions>
    <StackPanel Spacing="6" HorizontalAlignment="Center">
     <Image x:Name="Hero" Source="ms-appx:///Assets/Art/welcome-hero.png" Width="600" HorizontalAlignment="Center" Margin="0,0,0,4" AutomationProperties.AccessibilityView="Raw"/>
     <TextBlock Text="Welcome to ArmAware" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
     <TextBlock Text="See which apps run natively on your ARM PC" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
    <TextBlock Text="Download pages often spot Windows but not ARM, so it's easy to end up with the x64 version of an app when a native ARM64 one exists. Windows quietly runs it under emulation, which can cost speed and battery, and nothing tells you it happened." TextWrapping="Wrap" TextAlignment="Center"/>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Grid.Column="0">
        <StackPanel Spacing="6">
         <Image Source="ms-appx:///Assets/Art/feature-inspect.png" Width="56" Height="56" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw"/>
         <TextBlock Text="Reads program files" Style="{StaticResource BodyStrongTextBlockStyle}"/>
         <TextBlock Text="Checks which of your apps run natively and which are emulated." Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Grid.Column="1">
        <StackPanel Spacing="6">
         <Image Source="ms-appx:///Assets/Art/feature-find.png" Width="56" Height="56" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw"/>
         <TextBlock Text="Finds ARM64 versions" Style="{StaticResource BodyStrongTextBlockStyle}"/>
         <TextBlock Text="Shows where an ARM64 build or a Winget update is available." Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Grid.Column="2">
        <StackPanel Spacing="6">
         <Image Source="ms-appx:///Assets/Art/feature-control.png" Width="56" Height="56" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw"/>
         <TextBlock Text="You stay in control" Style="{StaticResource BodyStrongTextBlockStyle}"/>
         <TextBlock Text="Runs on your PC. Apps only change if you choose to run a suggested command." Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
    </Grid>
    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
     <StackPanel Spacing="6">
      <TextBlock Text="Also check online for ARM64 versions?" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabelStyle}" Text="Without this, ArmAware can show what is emulated but cannot find ARM64 builds to switch to. Checking online uses Windows Package Manager, which sends package IDs and versions to Microsoft's winget and Store catalogs. Your app list is not uploaded."/>
      <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.WingetChecking, Mode=OneWay}" Margin="0,4,0,0">
       <ProgressRing IsActive="{x:Bind ViewModel.WingetChecking, Mode=OneWay}" Width="14" Height="14"/>
       <TextBlock Text="Checking for Windows Package Manager…" Style="{StaticResource FieldLabelStyle}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.WingetReady, Mode=OneWay}" Margin="0,4,0,0">
       <FontIcon Glyph="{StaticResource GlyphNative}" FontSize="12" Foreground="{ThemeResource StatusNativeForegroundBrush}"/>
       <TextBlock Text="Windows Package Manager is ready." Style="{StaticResource FieldLabelStyle}"/>
      </StackPanel>
      <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WingetNeedsSetup, Mode=OneWay}" Margin="0,4,0,0">
       <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon Glyph="{StaticResource GlyphEmulated}" FontSize="12" Foreground="{ThemeResource StatusEmulatedForegroundBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
        <TextBlock Text="{x:Bind ViewModel.WingetMessage, Mode=OneWay}" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" MaxWidth="560"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Get App Installer" Click="GetAppInstaller_Click" Visibility="{x:Bind ViewModel.WingetMissing, Mode=OneWay}"/>
        <Button Content="Check again" Command="{x:Bind ViewModel.CheckWingetCommand}"/>
       </StackPanel>
      </StackPanel>
     </StackPanel>
    </Border>
    <StackPanel Spacing="8" HorizontalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Content="Scan and check online" Command="{x:Bind ViewModel.StartFirstScanCommand}" CommandParameter="online" IsEnabled="{x:Bind ViewModel.WingetReady, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Padding="16,7"/>
      <Button Content="Scan offline only" Command="{x:Bind ViewModel.StartFirstScanCommand}" CommandParameter="offline" Padding="16,7"/>
      <Button Content="Back to ArmAware" Command="{x:Bind ViewModel.CloseWelcomeCommand}" Visibility="{x:Bind ViewModel.CanLeaveWelcome, Mode=OneWay}" Padding="16,7"/>
     </StackPanel>
     <TextBlock Text="You can change this later in Settings." Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
